{
  "version": 2,
  "builds": [
    {
      "src": "backend/agent_app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/agent_app.py"
    },
    {
      "src": "/agent/(.*)",
      "dest": "backend/agent_app.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "backend/agent_app.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/agent_app.py"
    }
  ]
}