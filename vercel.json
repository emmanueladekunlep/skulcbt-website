{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "blog/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/features",
      "dest": "/features.html"
    },
    {
      "src": "/pricing",
      "dest": "/pricing.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/blog",
      "dest": "/blog.html"
    },
    {
      "src": "/demo-request",
      "dest": "/demo-request.html"
    },
    {
      "src": "/thank-you",
      "dest": "/thank-you.html"
    },
    {
      "src": "/faq",
      "dest": "/faq.html"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/blog/$1"
    },
    {
      "src": "/blog/why-school-fees-not-paid-on-time-nigeri",
      "dest": "/blog/why-school-fees-not-paid-on-time-nigeria.html",
      "permanent": true
    },
    {
      "src": "/blog/why-school-fees-not-paid-on-time-nigeria2",
      "dest": "/blog/why-school-fees-not-paid-on-time-nigeria.html",
      "permanent": true
    },
    {
      "src": "/blog/why-school-fees-not-paid-on-time-nigeri.html",
      "dest": "/blog/why-school-fees-not-paid-on-time-nigeria.html",
      "permanent": true
    },
    {
      "src": "/blog/why-school-fees-not-paid-on-time-nigeria2.html",
      "dest": "/blog/why-school-fees-not-paid-on-time-nigeria.html",
      "permanent": true
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}